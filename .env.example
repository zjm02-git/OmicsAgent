# 复制本文件为 .env，然后填上你的真实 Key（.env 已被 git 忽略，不会上传）
DEEPSEEK_API_KEY=在这里填你的key
MODEL_NAME=deepseek-v4-flash

# 是否用 PostgreSQL 持久化（检查点 + 长期记忆，重启不丢）
# 设 true 启用；不设或 false 用内存版（开箱即跑，重启后数据丢失）
USE_POSTGRES=false

# 本地 PostgreSQL 连接（启用 USE_POSTGRES=true 时用，和课程 6.2.4 同一个库）
DATABASE_URL=postgresql://langgraph_user:123456@localhost:5432/langgraph_db?sslmode=disable
